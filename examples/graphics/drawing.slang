use graphics as g

// The first drawing command creates a canvas. Close it when you are finished.
g.background<"#C8E8FF">
g.fill<"#4D9956">
g.rect<0, 330, 640, 150>
g.fill<"yellow">
g.circle<530, 90, 45>
g.fill<"#EAA46A">
g.rect<180, 200, 240, 180>
g.fill<"#A64B42">
g.rect<160, 175, 280, 30>
g.fill<"#65452E">
g.rect<275, 280, 55, 100>
g.fill<"white">
g.rect<205, 235, 45, 45>
g.rect<350, 235, 45, 45>
print<"Your drawing is ready. Close the canvas to finish.">
