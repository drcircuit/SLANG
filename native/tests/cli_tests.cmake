file(MAKE_DIRECTORY "${TEST_ROOT}/folder with spaces/Å lære")
file(WRITE "${TEST_ROOT}/folder with spaces/Å lære/eksempel.slang" "var score = 10\nif score is 10:\nprint<score>\n.\n")
file(WRITE "${TEST_ROOT}/bad.slang" "var score = 10\nif score = 10:\nprint<score>\n.\n")

execute_process(COMMAND "${SLANG_EXE}" check "${TEST_ROOT}/folder with spaces/Å lære/eksempel.slang" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "not type-checked or executed")
    message(FATAL_ERROR "Valid program failed: ${result}: ${output} ${error}")
endif()
execute_process(COMMAND "${SLANG_EXE}" check --json "${TEST_ROOT}/bad.slang" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 1)
    message(FATAL_ERROR "Invalid program should exit 1: ${result} ${output} ${error}")
endif()
string(JSON success GET "${output}" success)
string(JSON line GET "${output}" diagnostics 0 start line)
if(success OR NOT line EQUAL 2)
    message(FATAL_ERROR "Incorrect structured diagnostic: ${output}")
endif()
execute_process(COMMAND "${SLANG_EXE}" check "${TEST_ROOT}/bad.slang" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT error MATCHES ":2:10: error" OR NOT error MATCHES "Use 'is'")
    message(FATAL_ERROR "Missing useful source diagnostic: ${error}")
endif()
execute_process(COMMAND "${SLANG_EXE}" ast - INPUT_FILE "${TEST_ROOT}/folder with spaces/Å lære/eksempel.slang" RESULT_VARIABLE result OUTPUT_VARIABLE output)
string(JSON type GET "${output}" type)
if(NOT result EQUAL 0 OR NOT type STREQUAL "Program")
    message(FATAL_ERROR "Standard-input AST failed")
endif()
execute_process(COMMAND "${SLANG_EXE}" nonexistent "${TEST_ROOT}/bad.slang" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result EQUAL 2)
    message(FATAL_ERROR "Unsupported command should exit 2")
endif()
execute_process(COMMAND "${SLANG_EXE}" check "${TEST_ROOT}/missing.slang" RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(NOT result EQUAL 1 OR NOT error MATCHES "Cannot open source file")
    message(FATAL_ERROR "Missing file should exit 1 with a useful error")
endif()
execute_process(COMMAND "${SLANG_EXE}" --version RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "native interpreter")
    message(FATAL_ERROR "Version check failed")
endif()

execute_process(COMMAND "${SLANG_EXE}" run "${TEST_ROOT}/folder with spaces/Å lære/eksempel.slang" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "^10[\r\n]+$")
    message(FATAL_ERROR "Run failed: ${result}: ${output} ${error}")
endif()
file(WRITE "${TEST_ROOT}/runtime-error.slang" "var x = 1\nx = \"wrong\"\n")
execute_process(COMMAND "${SLANG_EXE}" run "${TEST_ROOT}/runtime-error.slang" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 1 OR NOT error MATCHES ":2:1: error" OR NOT error MATCHES "Expected int")
    message(FATAL_ERROR "Runtime diagnostic failed: ${result}: ${output} ${error}")
endif()
file(WRITE "${TEST_ROOT}/explicit-error.slang" "print<\"before\">\nerror<\"Age cannot be negative\">\nprint<\"after\">\n")
execute_process(COMMAND "${SLANG_EXE}" run "${TEST_ROOT}/explicit-error.slang" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 1 OR NOT output MATCHES "^before[\r\n]+$" OR NOT error MATCHES ":2:1: error" OR NOT error MATCHES "Age cannot be negative")
    message(FATAL_ERROR "Explicit error termination failed: ${result}: ${output} ${error}")
endif()
file(WRITE "${TEST_ROOT}/explicit-error-repl.txt" "var score = 42\nerror<\"Try again\">\nscore\n:quit\n")
execute_process(COMMAND "${SLANG_EXE}" repl INPUT_FILE "${TEST_ROOT}/explicit-error-repl.txt" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "42" OR NOT error MATCHES "Try again")
    message(FATAL_ERROR "Explicit error REPL recovery failed: ${result}: ${output} ${error}")
endif()
file(WRITE "${TEST_ROOT}/loop.slang" "while true:\n.\n")
execute_process(COMMAND "${SLANG_EXE}" run --max-steps 20 "${TEST_ROOT}/loop.slang" RESULT_VARIABLE result ERROR_VARIABLE error TIMEOUT 5)
if(NOT result EQUAL 1 OR NOT error MATCHES "Execution limit")
    message(FATAL_ERROR "Execution limit failed: ${result}: ${error}")
endif()
file(WRITE "${TEST_ROOT}/repl.txt" "var x = 40\nx + 2\nfunk Add <a, b>:\nretur a + b\n.\nAdd<x, 2>\nx = \"wrong\"\nx\n:reset\nvar x = 5\nx\n:quit\n")
execute_process(COMMAND "${SLANG_EXE}" repl INPUT_FILE "${TEST_ROOT}/repl.txt" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "42" OR NOT output MATCHES "40" OR NOT output MATCHES "Session reset" OR NOT output MATCHES "5" OR NOT error MATCHES "Expected int")
    message(FATAL_ERROR "Interactive console failed: ${result}: ${output} ${error}")
endif()
file(WRITE "${TEST_ROOT}/input.slang" "print<\"Hello \" + input<>>\n")
file(WRITE "${TEST_ROOT}/input.txt" "Ada\n")
execute_process(COMMAND "${SLANG_EXE}" run "${TEST_ROOT}/input.slang" INPUT_FILE "${TEST_ROOT}/input.txt" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "Hello Ada")
    message(FATAL_ERROR "Console input failed: ${result}: ${output} ${error}")
endif()

file(WRITE "${TEST_ROOT}/folder with spaces/Å lære/maths.slang" "lib maths:\nfunc Validate <x>:\nassert<x >= 0>\n.\npublic func Square <x>:\nValidate<x>\nret x * x\n.\n.\n")
file(WRITE "${TEST_ROOT}/folder with spaces/Å lære/main.slang" "use \"maths.slang\" as maths\nuse console\nconsole.print<maths.Square<5>>\n")
execute_process(COMMAND "${SLANG_EXE}" run "${TEST_ROOT}/folder with spaces/Å lære/main.slang" WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "^25[\r\n]+$")
    message(FATAL_ERROR "Relative module import from a Unicode path failed: ${result}: ${output} ${error}")
endif()
file(WRITE "${TEST_ROOT}/modules-repl.txt" "use \"maths.slang\" as maths\nmaths.Square<5>\nmaths.Validate<1>\nuse console as io\nio.print<maths.Square<6>>\n:reset\nuse \"maths.slang\" as maths\nmaths.Square<7>\n:quit\n")
execute_process(COMMAND "${SLANG_EXE}" repl WORKING_DIRECTORY "${TEST_ROOT}/folder with spaces/Å lære" INPUT_FILE "${TEST_ROOT}/modules-repl.txt" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "25" OR NOT output MATCHES "36" OR NOT output MATCHES "49" OR NOT error MATCHES "does not export 'Validate'")
    message(FATAL_ERROR "Module REPL failed: ${result}: ${output} ${error}")
endif()
file(WRITE "${TEST_ROOT}/inline-lib-repl.txt" "lib maths:\n\npublic func Square <val>:\n\nret val * val\n.\n\n.\nmaths.Square<8>\n:quit\n")
execute_process(COMMAND "${SLANG_EXE}" repl INPUT_FILE "${TEST_ROOT}/inline-lib-repl.txt" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "64" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Inline lib console input failed: ${result}: ${output} ${error}")
endif()
file(WRITE "${TEST_ROOT}/submit-repl.txt" "lib unfinished:\n:submit\n1 + 2\n:quit\n")
execute_process(COMMAND "${SLANG_EXE}" repl INPUT_FILE "${TEST_ROOT}/submit-repl.txt" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "3" OR NOT error MATCHES "closing period")
    message(FATAL_ERROR "Explicit submission recovery failed: ${result}: ${output} ${error}")
endif()

file(WRITE "${TEST_ROOT}/folder with spaces/Å lære/graphics.slang" "use graphics as g\ng.fill<\"blue\">\ng.circle<50, 50, 20>\ng.save<\"blå sirkel.png\">\nprint<input<>>\ng.close<>\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEO_DRIVER=dummy SDL_RENDER_DRIVER=software "${SLANG_EXE}" run "${TEST_ROOT}/folder with spaces/Å lære/graphics.slang" WORKING_DIRECTORY "${TEST_ROOT}" INPUT_FILE "${TEST_ROOT}/input.txt" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
if(NOT result EQUAL 0 OR NOT output MATCHES "Ada" OR NOT error STREQUAL "" OR NOT EXISTS "${TEST_ROOT}/folder with spaces/Å lære/blå sirkel.png")
    message(FATAL_ERROR "Graphics with input and source-relative Unicode paths failed: ${result}: ${output} ${error}")
endif()
file(WRITE "${TEST_ROOT}/graphics-repl.txt" "use graphics as g\ng.circle<10, 10, 2>\nprint<42>\n:reset\ng.circle<1, 1, 1>\nuse graphics as g\ng.circle<20, 20, 5>\ng.close<>\n:quit\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEO_DRIVER=dummy SDL_RENDER_DRIVER=software "${SLANG_EXE}" repl INPUT_FILE "${TEST_ROOT}/graphics-repl.txt" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
if(NOT result EQUAL 0 OR NOT output MATCHES "42" OR NOT error MATCHES "Unknown name 'g'" OR error MATCHES "Canvas is closed")
    message(FATAL_ERROR "Graphics console reset/recovery failed: ${result}: ${output} ${error}")
endif()
