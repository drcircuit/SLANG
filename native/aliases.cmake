# One source of truth for native bindings and editor completion.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/standard-aliases.json")
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/src/standard-aliases.json" slang_alias_json)
set(slang_alias_cpp "// Generated from src/standard-aliases.json.\n")
foreach(group modules builtins windowFields colors)
    string(APPEND slang_alias_cpp "const AliasMap& ${group}_aliases() { static const AliasMap value = {\n")
    string(JSON count LENGTH "${slang_alias_json}" ${group})
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON alias MEMBER "${slang_alias_json}" ${group} ${i})
        string(JSON original GET "${slang_alias_json}" ${group} ${alias})
        string(APPEND slang_alias_cpp "{\"${alias}\", \"${original}\"},\n")
    endforeach()
    string(APPEND slang_alias_cpp "}; return value; }\n")
endforeach()
string(APPEND slang_alias_cpp "const std::map<std::string, AliasMap>& function_aliases() { static const std::map<std::string, AliasMap> value = {\n")
string(JSON count LENGTH "${slang_alias_json}" functions)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    string(JSON library MEMBER "${slang_alias_json}" functions ${i})
    string(APPEND slang_alias_cpp "{\"${library}\", {\n")
    string(JSON members LENGTH "${slang_alias_json}" functions ${library})
    math(EXPR member_last "${members} - 1")
    foreach(j RANGE ${member_last})
        string(JSON alias MEMBER "${slang_alias_json}" functions ${library} ${j})
        string(JSON original GET "${slang_alias_json}" functions ${library} ${alias})
        string(APPEND slang_alias_cpp "{\"${alias}\", \"${original}\"},\n")
    endforeach()
    string(APPEND slang_alias_cpp "}},\n")
endforeach()
string(APPEND slang_alias_cpp "}; return value; }\n")
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/standard_aliases.inc" CONTENT "${slang_alias_cpp}" @ONLY)
