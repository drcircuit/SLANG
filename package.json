{
  "name": "slang-language",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "description": "Syntax prototype for a Scandinavian-keyboard-friendly teaching language",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test test/language.test.js",
    "check": "node src/cli.js check examples/english.slang examples/norsk.slang",
    "examples:test": "node --test test/showcase.test.js",
    "ide:build": "node scripts/build-ide.mjs",
    "ide": "npm run ide:build && electron ide",
    "ide:test": "node --test test/ide-language.test.js test/ide-protocol.test.js test/window-protocol.test.js test/ide-themes.test.js test/localization.test.js",
    "ide:themes": "node scripts/test-ide-themes.mjs",
    "ide:smoke": "node scripts/test-ide.mjs",
    "ide:package": "node scripts/package-ide.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:checksums": "node scripts/checksums.mjs"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "monaco-editor": "0.57.0",
    "playwright-core": "1.64.1",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "author": "SLANG contributors"
}
